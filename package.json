{
  "name": "kindle-monitor",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
    "description": "Editable PC hardware monitor for Kindle PW5 via the KOReader dashboard plugin or SSH",
  "author": "vvkis",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node scripts/run-desktop.cjs start",
    "test": "node --test tests/desktop.test.cjs tests/sensor-start.test.cjs tests/dashboard-plugin.test.cjs",
    "smoke": "node scripts/run-desktop.cjs smoke",
    "build": "node scripts/run-desktop.cjs build",
    "release": "node scripts/run-desktop.cjs release && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "prepare:assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-assets.ps1",
    "benchmark": "node scripts/run-desktop.cjs benchmark",
    "benchmark:memory": "node scripts/run-desktop.cjs memory"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.vvkis.kindle-monitor",
    "productName": "Kindle Monitor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "!desktop/**/*.cs",
      "!desktop/**/*.ps1",
      "!desktop/icon.ico",
      "!desktop/icon.svg",
      "package.json"
    ],
    "electronLanguages": ["en-US", "zh-CN"],
    "extraResources": [
      {
        "from": "vendor/lhm",
        "to": "lhm",
        "filter": [
          "*.dll",
          "!Aga.Controls.dll",
          "!OxyPlot*.dll",
          "LICENSE*",
          "THIRD-PARTY*",
          "SOURCE.txt"
        ]
      },
      {
        "from": "vendor/fonts",
        "to": "fonts",
        "filter": [
          "MapleMono-NF-CN-Regular.ttf",
          "MapleMono-NF-CN-Bold.ttf",
          "LICENSE.txt"
        ]
      },
      {
        "from": "vendor/sensors",
        "to": "sensors",
        "filter": [
          "*.exe",
          "*.config",
          "*.ps1",
          "LICENSE*",
          "SOURCE.txt"
        ]
      }
    ],
    "win": {
      "target": "dir",
      "icon": "desktop/icon.ico",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "asar": true
  }
}
